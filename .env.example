TASK_SOURCE=                 # (任意) タスクソース linear / clickup (既定: linear)

# TASK_SOURCE=linear のとき
LINEAR_PERSONAL_API_KEY=     # タスクソースのAPIキー
LINEAR_HUMAN_USER_ID=        # (任意) 人間のユーザーID。未設定なら、AI以外の有効メンバーが1人だけのとき自動で決まる

# TASK_SOURCE=clickup のとき
CLICKUP_PERSONAL_API_KEY=    # ClickUp の API キー (AIアカウントのもの)
CLICKUP_LIST_WORK=           # work グループのリストID
CLICKUP_LIST_PRIVATE=        # private グループのリストID

DISCORD_WEBHOOK_URL=         # 通知先 Discord Webhook
SLACK_WEBHOOK_URL=           # (任意) 通知先 Slack Incoming Webhook

ORCHESTRATOR_REPOSITORIES_PATH=  # (任意) リポジトリ一覧の場所 (既定: ~/.config/ai-orchestrator/repositories.json)
ORCHESTRATOR_WORKFLOW_PATH=      # (任意) ステータス名の設定 (既定: ~/.config/ai-orchestrator/workflow.json)
